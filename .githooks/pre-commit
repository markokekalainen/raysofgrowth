#!/usr/bin/env bash
set -euo pipefail

html_files=()
while IFS= read -r file; do
  html_files+=("$file")
done < <(git ls-files '*index.html')

current=""
for file in "${html_files[@]}"; do
  match="$(rg -No 'Version: [0-9]+' "$file" | head -n 1 || true)"
  if [[ -n "$match" ]]; then
    current="${match#Version: }"
    break
  fi
done

if [[ -z "$current" ]]; then
  exit 0
fi

next=$((current + 1))
changed=0

for file in "${html_files[@]}"; do
  if rg -q 'Version: [0-9]+' "$file"; then
    perl -0pi -e "s/Version: \\d+/Version: $next/g" "$file"
    changed=1
  fi
done

if [[ "$changed" -eq 1 ]]; then
  git add "${html_files[@]}"
fi
